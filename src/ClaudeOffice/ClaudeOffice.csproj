<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 알림 영역(트레이) 아이콘 NotifyIcon 때문. WPF 와 이름이 겹치는 것(MessageBox 등)이 많아 전역 using 은 뺀다 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeOffice</AssemblyName>
    <RootNamespace>ClaudeOffice</RootNamespace>
    <Product>Claude Office</Product>
    <!-- 버전 규칙(요청 하나마다 패치 +1, x.y.9 다음은 x.(y+1).0)은 CLAUDE.md, 기록은 docs/CHANGELOG.md -->
    <Version>1.9.16</Version>
    <!-- 실행 파일 아이콘(탐색기·바로가기). 창 아이콘은 MainWindow.xaml 의 Icon -->
    <ApplicationIcon>Assets\office_a.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeOffice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 사무실 화면(HTML/JS)은 실행 파일 옆 wwwroot 로 복사된다 -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 휴대폰 화면은 앱과 따로 배포되므로 화면 파일에도 버전을 적어 둔다(설정 맨 위에 표시). 버전을 올리며 빠뜨리면 여기서 멈춘다 -->
  <Target Name="CheckPageVersion" BeforeTargets="BeforeBuild">
    <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\wwwroot\office.js').Contains(&quot;const PAGE_VERSION = '$(Version)';&quot;))"
           Text="wwwroot\office.js 의 PAGE_VERSION 을 csproj 버전($(Version))과 같게 고쳐 주세요." />
  </Target>

  <!-- 아이콘: 사무실 화면의 픽셀아트 직원(Assets\office_pixel.png, 1배 그림)에서 tools\make-icon.ps1 -Pixel 로 만든다.
       휴대폰 앱 아이콘은 tools\make-app-icons.ps1 -Pixel -->
  <ItemGroup>
    <Resource Include="Assets\office_a.ico" />
    <Resource Include="Assets\office_b.ico" />
    <Resource Include="Assets\office_c.ico" />
  </ItemGroup>

</Project>
