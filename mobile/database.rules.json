{
  "rules": {
    ".read": false,
    ".write": false,
    "offices": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['v', 't', 'iv', 'ct']) && newData.child('ct').isString() && newData.child('ct').val().length < 500000"
      }
    }
  }
}
